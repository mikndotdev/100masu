{
  "name": "realtime",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build --compile src/index.ts --outfile realtime",
    "typecheck": "tsc",
    "check-types": "tsc",
    "test:e2e": "bun run tests/multiplayer.e2e.ts",
    "test:e2e:cross": "bun run tests/crossInstance.e2e.ts",
    "test:e2e:cleanup": "bun run tests/cleanup.e2e.ts",
    "test:e2e:late": "bun run tests/lateJoin.e2e.ts",
    "test:e2e:discord": "bun run tests/discord.e2e.ts",
    "test:e2e:host": "bun run tests/hostTransfer.e2e.ts"
  },
  "dependencies": {
    "@100masu/db": "workspace:*",
    "@100masu/env": "workspace:*",
    "@100masu/game": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "elysia": "1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "catalog:"
  }
}
