{
  "name": "100masu",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@prisma/client": "^7.8.0",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/canvas-confetti": "^1.9.0",
      "@types/howler": "^2.2.13",
      "@types/node": "^22.13.14",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "canvas-confetti": "^1.9.4",
      "daisyui": "^5.7.16",
      "dotenv": "^17.4.2",
      "howler": "^2.2.4",
      "i18next": "^26.3.6",
      "lucide-react": "^1.23.0",
      "motion": "^12.42.2",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "react-i18next": "^17.0.11",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "typescript": "^6",
      "vaul": "^1.1.2",
      "zod": "^4.4.3",
      "zustand": "^5.0.14"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:realtime": "turbo run build -F realtime",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "db:push": "turbo run db:push -F @100masu/db",
    "db:studio": "turbo run db:studio -F @100masu/db",
    "db:generate": "turbo run db:generate -F @100masu/db",
    "db:migrate": "turbo run db:migrate -F @100masu/db",
    "check": "oxlint && oxfmt --write",
    "format": "oxfmt --write"
  },
  "dependencies": {
    "@100masu/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@100masu/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.11"
}
